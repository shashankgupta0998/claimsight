# replay = deterministic offline run from recorded cassettes (CI, evals)
# live   = real models and real APIs (NHTSA, NOAA SPC, Open-Meteo)
CLAIMSIGHT_MODE=replay

CLAIMSIGHT_DATABASE_URL=postgresql://claimsight:claimsight@localhost:5432/claimsight
# Graph state: memory | postgres (claims awaiting review survive restarts; needs the pg extra)
CLAIMSIGHT_CHECKPOINTER=memory
CLAIMSIGHT_REDIS_URL=redis://localhost:6379/0

# Models
CLAIMSIGHT_DETECTOR_MODEL=your-hf-username/rtdetr-cardd
CLAIMSIGHT_PART_DETECTOR_MODEL=google/owlv2-base-patch16-ensemble
CLAIMSIGHT_ASR_MODEL=openai/whisper-large-v3-turbo
CLAIMSIGHT_REASONING_MODEL=claude-sonnet-5-5
CLAIMSIGHT_ROUTING_MODEL=claude-haiku-5-5

# Policy retrieval: keyword | dense | hybrid, optional cross-encoder rerank, memory | pgvector
CLAIMSIGHT_RETRIEVER=dense
CLAIMSIGHT_RERANK=true
CLAIMSIGHT_VECTOR_STORE=memory
CLAIMSIGHT_EMBED_MODEL=BAAI/bge-small-en-v1.5
CLAIMSIGHT_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# LLM query rewriting: off | replace | expand | joint | dual (needs the llm extra)
CLAIMSIGHT_QUERY_REWRITE=off
CLAIMSIGHT_PAGE_LANE=off
CLAIMSIGHT_REWRITE_MODEL=claude-opus-5-5

# Decision policy
CLAIMSIGHT_ESCALATION_CONFIDENCE=0.6
CLAIMSIGHT_AUTO_APPROVE_LIMIT_USD=5000

# Read directly by their SDKs
ANTHROPIC_API_KEY=
# Langfuse tracing (claimsight/tracing.py): off while the keys are empty.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Send statements and clause text with traces (they hold personal data in production)
CLAIMSIGHT_TRACE_CONTENT=false
CLAIMSIGHT_COVERAGE_REVIEW=llm
CLAIMSIGHT_COVERAGE_REVIEW_ROUTING=haiku_first
CLAIMSIGHT_COVERAGE_REVIEW_LAYOUT=statement_first
CLAIMSIGHT_PHOTO_CHECK=off
CLAIMSIGHT_PHOTO_EMBEDDINGS=off
