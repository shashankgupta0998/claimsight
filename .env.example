# replay = deterministic offline run from recorded cassettes (CI, evals)
# live   = real models and real APIs (NHTSA, NOAA SPC, Open-Meteo)
CLAIMSIGHT_MODE=replay

CLAIMSIGHT_DATABASE_URL=postgresql://claimsight:claimsight@localhost:5432/claimsight
CLAIMSIGHT_REDIS_URL=redis://localhost:6379/0

# Models
CLAIMSIGHT_DETECTOR_MODEL=your-hf-username/rtdetr-cardd
CLAIMSIGHT_PART_DETECTOR_MODEL=google/owlv2-base-patch16-ensemble
CLAIMSIGHT_ASR_MODEL=openai/whisper-large-v3-turbo
CLAIMSIGHT_EMBED_MODEL=BAAI/bge-m3
CLAIMSIGHT_REASONING_MODEL=claude-sonnet-5-5
CLAIMSIGHT_ROUTING_MODEL=claude-haiku-5-5

# Decision policy
CLAIMSIGHT_ESCALATION_CONFIDENCE=0.6
CLAIMSIGHT_AUTO_APPROVE_LIMIT_USD=5000

# Read directly by their SDKs
ANTHROPIC_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
